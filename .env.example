# Safe local defaults. Do not put private keys or credentials in this file.
# System settings overrides use an explicit, allowlisted nested prefix.
SEV_CONFIG__MODE=privacy
SEV_CONFIG__AGGREGATOR_URL=http://localhost:8000
# SEV_CONFIG__SECURITY__MAX_CLOCK_SKEW_SECONDS=30
# SEV_CONFIG__SECURITY__NONCE_TTL_SECONDS=300
# SEV_CONFIG__SECURITY__MAX_REQUEST_BYTES=262144
# SEV_CONFIG__VISION__MODEL=yolo26n.pt
# SEV_CONFIG__VISION__DEVICE=auto
# SEV_CONFIG__VISION__IMAGE_SIZE=640
# SEV_CONFIG__VISION__CONFIDENCE=0.25
# SEV_CONFIG__VISION__FRAME_SAMPLE_FPS=2
# Consensus overrides are future configuration only; they enable no behavior.
# SEV_CONFIG__CONSENSUS__POLICY=trust_weighted
# SEV_CONFIG__CONSENSUS__IOU_THRESHOLD=0.50
# SEV_CONFIG__CONSENSUS__ACCEPT_THRESHOLD=0.60
# SEV_CONFIG__CONSENSUS__ALPHA=0.85
# SEV_CONFIG__CONSENSUS__TRUST_MIN=0.05
SEV_NODE_ID=edge-1
SEV_CAMERA_ID=cam-1
SEV_CONFIG_PATH=config/system.yaml
# Local filesystem path or camera:<non-negative-index>; never a network URI.
# SEV_MEDIA_SOURCE=data/sample.mp4
SEV_DATABASE_URL=sqlite:///state/secureedgevision.db
SEV_LOG_LEVEL=INFO
